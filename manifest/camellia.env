# Manifest: Poco M3 Pro 5G / Redmi Note 10 5G (camellia)
# Semua yang device-specific soal SUMBER (kernel source, toolchain) ada di
# sini, biar workflow .yml gak perlu diubah kalau cuma ganti source/branch/
# toolchain. Format: KEY=VALUE polos, satu baris satu variabel, baris kosong
# atau diawali "#" diabaikan. Nilai yang ada spasi/tanda kutip (mis.
# EXTRA_CMDS) ditulis apa adanya, akan diteruskan persis ke GITHUB_ENV.

# --- Kernel source ---
KERNEL_SOURCE=https://github.com/cristidclxvi/android_kernel_xiaomi_camellia.git
KERNEL_BRANCH=lineage-23.2

# --- Clang toolchain ---
CLANG_SOURCE=https://github.com/bachnxuan/aosp_clang_mirror/releases/download/clang-r563880c-13989888/clang-r563880c.tar.gz
CLANG_BRANCH=

# --- GCC fallback toolchain (dipakai bareng clang untuk binutils/AS/LD) ---
GCC_GNU=false
GCC_64_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9.git
GCC_64_BRANCH=android12L-release
GCC_32_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9.git
GCC_32_BRANCH=android12L-release

# --- Flag compiler tambahan ---
# CROSS_COMPILE/CLANG_TRIPLE: prefix toolchain target.
CUSTOM_CMDS=CROSS_COMPILE=aarch64-linux-android- CLANG_TRIPLE=aarch64-linux-gnu-
# KCFLAGS="-gdwarf-4 ...": lihat komentar panjang di riwayat commit workflow
# soal kenapa ini dibutuhin (GCC_64 4.9 + binutils lama gak paham DWARF5
# yang di-emit clang modern, dan kernel vendor ini masih banyak fungsi gaya
# K&R/implicit-int).
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 KCFLAGS="-gdwarf-4 -Wno-implicit-int -Wno-error=implicit-int"
